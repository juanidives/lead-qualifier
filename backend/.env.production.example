# ============================================================
# .env.production — Variáveis de ambiente para o servidor
# ============================================================
# INSTRUÇÕES:
#   1. Copie este arquivo: cp .env.production.example .env.production
#   2. Preencha os valores reais (nunca commite .env.production no git)
# ============================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-proj-COLOQUE_SUA_CHAVE_AQUI
OPENAI_MODEL=gpt-4.1-mini

# --- Cliente ativo (deve corresponder a uma pasta em clients/) ---
CLIENT=jb_bebidas

# --- Evolution API (WhatsApp gateway) ---
# NÃO alterar URL — FastAPI e Evolution API comunicam internamente pelo Docker
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=COLOQUE_UMA_CHAVE_SEGURA_AQUI
EVOLUTION_INSTANCE=jb-bebidas

# Chave usada no header `x-api-key` do webhook /webhook/whatsapp.
# Gere com: openssl rand -hex 32
WEBHOOK_API_KEY=COLOQUE_UMA_CHAVE_HEX_DE_64_CARACTERES_AQUI

# --- Redis (broker do Celery) ---
# NÃO alterar — Redis comunica internamente pelo Docker
REDIS_URL=redis://redis:6379/0

# --- PostgreSQL (memória persistente) ---
# NÃO alterar host/db — Postgres comunica internamente pelo Docker.
# Trocar a senha por uma forte e refletir no docker-compose.
POSTGRES_URL=postgresql://evolution:COLOQUE_SENHA_SEGURA_AQUI@postgres:5432/leadqualifier

# --- Info do negócio ---
# Telefone do dono que recebe notificações (formato internacional sem +)
OWNER_PHONE=COLOQUE_TELEFONE_DO_DONO_AQUI
